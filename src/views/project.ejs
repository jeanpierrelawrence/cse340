<%- include('partials/header') %>

<main class="container">
    <h1><%= projectDetails.title %></h1>

    <div class="card">
        <p>
            <strong>Date:</strong> 
            <%= new Date(projectDetails.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </p>
        <p><strong>Location:</strong> <%= projectDetails.location %></p>
        <p>
            <strong>Organization:</strong> 
            <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
        </p>
        <p class="org-description"><%= projectDetails.description %></p>

        <% if (categories && categories.length > 0) { %>
            <div class="category-tags">
                <strong>Categories:</strong>
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>" class="category-tag"><%= category.name %></a>
                <% }); %>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>