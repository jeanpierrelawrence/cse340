<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>

    <div class="card">
        <div class="card-media">
            <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
        </div>
        <h2><%= organizationDetails.name %></h2>
        <p class="org-description"><%= organizationDetails.description %></p>
        <p><strong>Contact:</strong> <%= organizationDetails.contact_email %></p>
    </div>

    <h3>Service Projects</h3>
    <div class="card-grid">
        <% projects.forEach(project => { %>
            <div class="card">
                <h4><a href="/project/<%= project.project_id %>"><%= project.title %></a></h4>
                <p>
                    <strong>Date:</strong> 
                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
                <p><%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
            </div>
        <% }) %>
    </div>
</main>

<%- include('partials/footer') %>