<%- include('partials/header') %>

<main class="container">
    <h1><%= organizationDetails.name %></h1>

    <div class="detail-card">
        <div class="card-media">
            <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
        </div>
        <p class="org-description"><%= organizationDetails.description %></p>

        <div class="detail-meta">
            <div class="detail-meta-item">
                <span class="detail-label">Contact</span>
                <span><%= organizationDetails.contact_email %></span>
            </div>
        </div>
    </div>

    <h2 class="section-heading">Service Projects</h2>
    <div class="card-grid">
        <% projects.forEach(project => { %>
            <div class="card">
                <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                <p>
                    <strong>Date:</strong> 
                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
                <p><%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
            </div>
        <% }) %>
    </div>
</main>

<%- include('partials/footer') %>