<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>
    <p class="intro-text">Explore our core service project categories:</p>

    <div class="card-grid">
        <% categories.forEach(category => { %>
            <div class="card">
                <h2><%= category.name %></h2>
            </div>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>