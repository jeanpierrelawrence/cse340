<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>
    <p class="intro-text">Explore our service categories:</p>

    <div class="card-grid">
        <% categories.forEach(category => { %>
            <div class="card">
                <h2>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </h2>
            </div>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>