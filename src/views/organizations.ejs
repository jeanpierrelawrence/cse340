<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>
    <p class="intro-text">Here are a few of our partner organizations:</p>

    <div class="card-grid">
        <div class="card">
            <div class="card-media">
                <img src="/images/brightfuture-logo.png" alt="BrightFuture Builders logo">
            </div>
            <h2>BrightFuture Builders</h2>
            <p class="org-description">Empowering local communities through sustainable architecture, youth vocational training, and housing renovation initiatives.</p>
            <p><strong>Contact:</strong> info@brightfuture.org</p>
        </div>

        <div class="card">
            <div class="card-media">
                <img src="/images/greenharvest-logo.png" alt="GreenHarvest Growers logo">
            </div>
            <h2>GreenHarvest Growers</h2>
            <p class="org-description">Dedicated to urban agriculture, community garden development, and providing fresh, organic produce to local food shelters.</p>
            <p><strong>Contact:</strong> contact@greenharvest.org</p>
        </div>

        <div class="card">
            <div class="card-media">
                <img src="/images/unityserve-logo.png" alt="UnityServe Volunteers logo">
            </div>
            <h2>UnityServe Volunteers</h2>
            <p class="org-description">Mobilizing volunteers for disaster relief, elderly care support, and neighborhood outreach programs across the region.</p>
            <p><strong>Contact:</strong> hello@unityserve.org</p>
        </div>
    </div>
</main>

<%- include('partials/footer') %>