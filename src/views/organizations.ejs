<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>
    <p class="intro-text">Here are a few of our partner organizations:</p>

    <div class="card-grid">
        <% organizations.forEach(organization => { %>
            <div class="card">
                <div class="card-media">
                    <a href="/organization/<%= organization.organization_id %>">
                        <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    </a>
                </div>
                <h2>
                    <a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a>
                </h2>
                <p class="org-description"><%= organization.description %></p>
                <p><strong>Contact:</strong> <%= organization.contact_email %></p>
            </div>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>