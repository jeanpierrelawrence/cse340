<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>
    <p class="intro-text">Upcoming Service Projects</p>

    <div class="card-grid">
        <% projects.forEach(project => { %>
            <div class="card">
                <h2><%= project.title %></h2>
                <p>
                    <strong>Date:</strong> 
                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %> 
                    (<em><%= project.organization_name %></em>)
                </p>
                <p class="org-description"><%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
            </div>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>