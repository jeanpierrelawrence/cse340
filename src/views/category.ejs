<%- include('partials/header') %>

<main class="container">
    <h1><%= categoryDetails.name %></h1>
    <p class="intro-text">Service projects in this category:</p>

    <div class="card-grid">
        <% projects.forEach(project => { %>
            <div class="card">
                <h2>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </h2>
                <p>
                    <strong>Date:</strong> 
                    <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
                <p>
                    <strong>Organization:</strong> 
                    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                </p>
                <p class="org-description"><%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
            </div>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>